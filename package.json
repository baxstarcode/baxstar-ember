{
  "name": "baxstar-ember",
  "version": "4.1.0",
  "private": true,
  "description": "Brady Baxter's AI command center for Baxstar Fishing and Lakes Golf Simulator.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:pages": "npm run build && node scripts/stage-pages.mjs",
    "serve": "python3 -m http.server 8080",
    "test:worker": "node proxy/worker.test.mjs",
    "test:tokens": "node --test proxy/token-coordinator.test.mjs proxy/token-coordinator-runtime.test.mjs",
    "test:pages": "node --test .devtest/pages-api-gateway.test.mjs",
    "test:outbox": "node apps-script/outbox/outbox.test.mjs",
    "test:posttime": "node .devtest/posttime.test.mjs",
    "test:dashboard": "node .devtest/dashboard-check.mjs",
    "test:chat": "node .devtest/chat-regression.mjs",
    "test:layout": "node .devtest/layout-truth-check.mjs",
    "test:streaming": "node .devtest/streaming-effort.mjs",
    "test:ecosystem": "node .devtest/eco-graph-check.mjs",
    "test:ui": "node .devtest/ui-rework-check.mjs",
    "test:voice-grace": "node --test work/desktop-voice-probe/grace.test.mjs",
    "test:voice-probe": "npm run test:voice-grace && node work/desktop-voice-probe/test.mjs",
    "test:caption": "node .devtest/caption-e2e.mjs",
    "test:core": "npm run test:worker && npm run test:tokens && npm run test:pages && npm run test:outbox && npm run test:posttime",
    "test:browser": "npm run test:chat && npm run test:dashboard && npm run test:local-state && npm run test:mobile && npm run test:layout && npm run test:streaming && npm run test:ecosystem && npm run test:ui && npm run test:alternative && npm run test:caption",
    "test": "npm run test:core && npm run test:browser && npm run test:voice-probe && npm run test:voice-recording",
    "test:release": "npm run build:pages && npm test",
    "test:sponsors": "node scripts/check-sponsor-drift.mjs",
    "test:local-state": "node .devtest/local-state-check.mjs",
    "test:mobile": "node .devtest/mobile-usability-check.mjs",
    "test:alternative": "node .devtest/alternative-check.mjs",
    "test:voice-recording": "node --test proxy/voice.test.mjs && node .devtest/voice-recording-check.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "miniflare": "4.20260730.0",
    "playwright": "^1.49.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "3.4.17"
  }
}
